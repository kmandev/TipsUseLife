{
  "name": "tipsuselife-facebook-feed-webhook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node --check src/index.js && node --check src/pipeline.js",
    "d1:inspect": "wrangler d1 execute tipsuselife-ai --remote --command \"SELECT name, type FROM sqlite_master ORDER BY type, name;\"",
    "d1:migrate": "wrangler d1 migrations apply tipsuselife-ai --remote"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
