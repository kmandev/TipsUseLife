{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facebook-feed-webhook",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  // Non-sensitive configuration only. Secrets (META_APP_SECRET,
  // META_VERIFY_TOKEN, HERMES_API_KEY, ADMIN_PASSWORD, ADMIN_SESSION_SECRET,
  // and -- only for LIVE -- PAGE_ACCESS_TOKEN) are set with
  // `wrangler secret put` and are never committed here.
  // Optional var: AFFILIATE_ALLOWED_HOSTS (comma separated) overrides the
  // default affiliate link host allow-list in src/config.js.
  "vars": {
    // SAFETY: DRY_RUN means no Facebook reply mutation is ever performed.
    // Only the exact string "LIVE" enables live replies, and LIVE also
    // requires a PAGE_ACCESS_TOKEN secret to be present.
    "REPLY_MODE": "DRY_RUN",
    "PAGE_ID": "853313081388711",
    "HERMES_URL": "https://hermes-feed.cloudnext.icu/v1/chat/completions",
    "HERMES_TIMEOUT_MS": "25000",
    "GRAPH_API_VERSION": "v21.0",
    "MAX_REPLY_LENGTH": "300"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tipsuselife-ai",
      "database_id": "c5621ac3-eb15-4044-8d87-6a0ebde8209b",
      // Migrations live at the repo root, outside the Worker directory.
      "migrations_dir": "../database/migrations"
    }
  ],

  // Brute-force throttle for POST /admin/login (src/admin.js,
  // loginAttemptAllowed): 5 attempts per 60 s per client IP. Cloudflare's
  // limiter is per-location and eventually consistent -- a throttle, not
  // an exact counter. If this binding is removed, login still works.
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "7001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
